# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/staj_platform
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/staj_platform

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Scraper
SCRAPER_BASE_DELAY=3.0
SCRAPER_MAX_DELAY=120.0
SCRAPER_JITTER_MIN=1.0
SCRAPER_JITTER_MAX=3.0
SCRAPER_REQUESTS_PER_MINUTE=10

# Proxy (optional)
PROXY_ENABLED=false
PROXY_URL=

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Scheduler
SCHEDULER_ENABLED=true
SCRAPE_INTERVAL_HOURS=6
